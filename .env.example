# --- Slack ---
# Bot User OAuth Token (starts xoxb-) — Slack app > OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-
# Signing Secret — Slack app > Basic Information > App Credentials
SLACK_SIGNING_SECRET=

# --- Xano ---
# Full URL of the POST endpoint you create (see README)
XANO_VISIBILITY_URL=https://xqtb-2ma7-ijfy.n7e.xano.io/api:aow91bcd/vendor/visibility
# Shared secret. Sent BOTH as the X-Api-Key header and as the `secret` body field;
# Xano checks the body field. Must match the literal in ep279's precondition.
XANO_API_KEY=
# Optional: deep link shown in error replies so ops can check manually
XANO_TABLE_URL=

# --- Behaviour (all optional) ---
# Emoji names without colons. Comma-separated to accept aliases.
TRIGGER_EMOJI=face_with_peeking_eye
# Lock the bot to specific channels. Empty = every channel it's in.
ALLOWED_CHANNEL_IDS=
# Lock triggering to specific people. Empty = anyone in the channel.
ALLOWED_USER_IDS=
# Removing the reaction restores visibility. Set false to disable undo.
ENABLE_UNDO=true
# Require a different person to approve a staged edit than the one who proposed it.
# Off by default; on a small team it blocks routine work.
REQUIRE_SECOND_APPROVER=false
# Only needed if the staged-edit endpoints move to a different Xano API group.
# Otherwise derived from XANO_VISIBILITY_URL.
XANO_API_BASE=

# --- Q&A on mention (optional, off by default) ---
# Set true to let @mentions ask read-only questions about Xano data.
ENABLE_ASK=false
# Anthropic API key (console.anthropic.com). Billed per token.
ANTHROPIC_API_KEY=
# Xano MCP server Streaming URL: Agents & MCP > MCP Servers > Copy Connection URL
XANO_MCP_URL=
# Only if you enable authentication on the Xano MCP server (you should)
XANO_MCP_TOKEN=
# Override the answering model if you want
ANSWER_MODEL=claude-sonnet-5

# --- Admin "view as user" (optional, OFF unless someone is named) ---
# Slack user ids allowed to run `/tulle view-as <email>`. Profile > ... > Copy member ID.
#
# NOTE THE INVERTED RULE: unlike ALLOWED_USER_IDS / ALLOWED_CHANNEL_IDS above,
# EMPTY HERE MEANS DENY EVERYONE, not allow everyone. A view-as session is a live
# session as a real paying customer, so it stays off until you name someone.
IMPERSONATE_USER_IDS=
# Shared secret for POST /admin/impersonate/mint. DIFFERENT from XANO_API_KEY on
# purpose: minting a customer session is higher-privilege than staging a vendor edit,
# and the two must not fall together if one leaks.
XANO_IMPERSONATE_KEY=
